---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Hideki & Jimmi Engagement Tour '26",
  description = "Engagement party tour dates, details, and RSVP pages."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#94F345" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

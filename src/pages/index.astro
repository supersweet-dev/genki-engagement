---
import BaseLayout from "../layouts/BaseLayout.astro";
import PapelPicado from "../components/PapelPicado.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TourMarquee from "../components/TourMarquee.astro";
import { tourStops } from "../data/events";
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="hero poster-field" aria-labelledby="page-title">
      <div class="hero-copy">
        <h1 class="tour-title" id="page-title">
          <span class="title-names">
            <span>hideki</span>
            <img src="/assets/logo.png" alt="and" />
            <span>jimmi</span>
          </span>
          <span class="title-tour">
            <span class="title-words">
              <span>engagement</span>
              <span>tour</span>
            </span>
            <span class="title-year">'26</span>
          </span>
        </h1>
        <div class="hero-photo" aria-label="Hideki and Jimmi">
          <img src="/assets/hj-photo.png" alt="Hideki and Jimmi" />
        </div>
      </div>
      <div class="hero-bill" aria-label="Tour dates">
        {tourStops.map((stop) => (
          <a class="bill-row" href={`/dates/${stop.slug}`}>
            <span>{stop.dateLabel}</span>
            <span>{stop.city}</span>
            <span class="bill-venue">
              <span data-lang="es">{stop.venueEs}</span>
              <span data-lang="en">{stop.venue}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="hero-actions">
        <a class="button-primary" href="#dates">
          <span data-lang="es">Más Info</span>
          <span data-lang="en">More Info</span>
        </a>
        <a class="button-secondary" href="/rsvp/monterrey">RSVP</a>
      </div>
    </section>

    <PapelPicado />

    <TourMarquee />

    <section class="dates-section" id="dates" aria-labelledby="dates-title">
      <img class="poster-stamp stamp-sheepcat" src="/assets/sheepcat.png" alt="" aria-hidden="true" />
      <div class="section-label">
        <span data-lang="es">Fechas</span>
        <span data-lang="en">Tour Stops</span>
      </div>
      <h2 id="dates-title">
        <span data-lang="es">Cuatro noches, una fiesta</span>
        <span data-lang="en">Four nights, one party</span>
      </h2>
      <div class="date-grid">
        {tourStops.map((stop) => (
          <article class="date-card">
            <a class="date-card-main" href={`/dates/${stop.slug}`}>
              <time datetime={stop.date}>{stop.dateLabel}</time>
              <h3>{stop.city}</h3>
              <p>
                <span data-lang="es">{stop.venueEs}</span>
                <span data-lang="en">{stop.venue}</span>
              </p>
            </a>
            <div class="date-card-actions">
              <a href={`/dates/${stop.slug}`}>
                <span data-lang="es">Detalles</span>
                <span data-lang="en">Details</span>
              </a>
              {
                stop.acceptsRsvp !== false ? (
                  <a href={`/rsvp/${stop.slug}`}>RSVP</a>
                ) : (
                  stop.addressHref && (
                    <a href={stop.addressHref}>
                      <span data-lang="es">Unirse</span>
                      <span data-lang="en">Join Server</span>
                    </a>
                  )
                )
              }
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PapelPicado from "../../components/PapelPicado.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getTourStop, tourStops } from "../../data/events";

export function getStaticPaths() {
  return tourStops
    .filter((stop) => stop.acceptsRsvp !== false)
    .map((stop) => ({
      params: { slug: stop.slug }
    }));
}

const stop = getTourStop(Astro.params.slug ?? "");

if (!stop) {
  return Astro.redirect("/");
}
---

<BaseLayout title={`RSVP ${stop.city} | Hideki & Jimmi Engagement Tour '26`}>
  <SiteHeader />
  <main>
    <section class="rsvp-shell poster-field" aria-labelledby="rsvp-title">
      <img class="poster-stamp stamp-rsvp" src="/assets/gem-flag.png" alt="" aria-hidden="true" />
      <a class="back-link" href={`/dates/${stop.slug}`}>
        <span data-lang="es">Volver a {stop.city}</span>
        <span data-lang="en">Back to {stop.city}</span>
      </a>
      <p class="kicker">
        {stop.dateLabel} /
        <span data-lang="es">{stop.venueEs}</span>
        <span data-lang="en">{stop.venue}</span>
      </p>
      <h1 class="fit-title rsvp-title" id="rsvp-title">RSVP {stop.city}</h1>
      {
        stop.rsvpDeadline && (
          <p class="rsvp-deadline">
            <span data-lang="es">{stop.rsvpDeadlineEs}</span>
            <span data-lang="en">{stop.rsvpDeadline}</span>
          </p>
        )
      }
      <PapelPicado class="form-picado" />

      <form
        class="rsvp-form"
        action="/api/rsvp"
        method="post"
      >
        <input type="hidden" name="event_slug" value={stop.slug} />
        <input type="hidden" name="event_city" value={stop.city} />
        <input type="hidden" name="event_date" value={stop.date} />
        <label class="hp-field" aria-hidden="true">
          Website
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <label>
          <span data-lang="es">Nombre</span>
          <span data-lang="en">Name</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span data-lang="es">Telefono</span>
          <span data-lang="en">Phone</span>
          <input name="phone" type="tel" autocomplete="tel" required />
        </label>
        <label>
          <span data-lang="es">Invitados</span>
          <span data-lang="en">Guests</span>
          <select name="guests" required>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
        </label>
        <fieldset>
          <legend>
            <span data-lang="es">Puedes venir?</span>
            <span data-lang="en">Can you make it?</span>
          </legend>
          <label class="choice">
            <input type="radio" name="attending" value="yes" required />
            <span data-lang="es">Si</span>
            <span data-lang="en">Yes</span>
          </label>
          <label class="choice">
            <input type="radio" name="attending" value="no" />
            No
          </label>
        </fieldset>
        {
          stop.slug === "monterrey" && (
            <fieldset>
              <legend>
                <span data-lang="es">Viajarias a Montemorelos / Santiago y te quedarias la noche?</span>
                <span data-lang="en">Would you travel to Montemorelos / Santiago and stay overnight?</span>
              </legend>
              <label class="choice">
                <input type="radio" name="overnight_travel" value="yes" required />
                <span data-lang="es">Si</span>
                <span data-lang="en">Yes</span>
              </label>
              <label class="choice">
                <input type="radio" name="overnight_travel" value="no" />
                No
              </label>
            </fieldset>
          )
        }
        {
          stop.showNoteField !== false && (
            <label>
              <span data-lang="es">Cancion / nota</span>
              <span data-lang="en">Song request / note</span>
              <textarea name="note" rows="5" required></textarea>
            </label>
          )
        }
        <button type="submit">
          <span data-lang="es">Enviar RSVP</span>
          <span data-lang="en">Send RSVP</span>
        </button>
      </form>
    </section>
  </main>
</BaseLayout>

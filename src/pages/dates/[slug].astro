---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PapelPicado from "../../components/PapelPicado.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import TourMarquee from "../../components/TourMarquee.astro";
import { getTourStop, tourStops } from "../../data/events";

export function getStaticPaths() {
  return tourStops.map((stop) => ({
    params: { slug: stop.slug }
  }));
}

const stop = getTourStop(Astro.params.slug ?? "");

if (!stop) {
  return Astro.redirect("/");
}

const detailItems = stop.detailsEs;
---

<BaseLayout title={`${stop.city} | Hideki & Jimmi Engagement Tour 26`}>
  <SiteHeader />
  <main>
    <section class="detail-hero poster-field" aria-labelledby="stop-title">
      <img class="poster-stamp stamp-detail" src="/assets/lamp.png" alt="" aria-hidden="true" />
      <a class="back-link" href="/#dates">
        <span data-lang="es">Volver a fechas</span>
        <span data-lang="en">Back to dates</span>
      </a>
      <h1 class="fit-title" id="stop-title">{stop.city}</h1>
      <p class="venue-line">
        <span data-lang="es">{stop.venueEs}</span>
        <span data-lang="en">{stop.venue}</span>
      </p>
      <dl class="stop-facts">
        <div>
          <dt>
            <span data-lang="es">Fecha</span>
            <span data-lang="en">Date</span>
          </dt>
          <dd><time datetime={stop.date}>{stop.dateLabel}, 2026</time></dd>
        </div>
        <div>
          <dt>
            <span data-lang="es">Lugar</span>
            <span data-lang="en">Place</span>
          </dt>
          <dd>
            {
              stop.addressHref ? (
                <a href={stop.addressHref}>
                  <span data-lang="es">{stop.addressEs}</span>
                  <span data-lang="en">{stop.address}</span>
                </a>
              ) : (
                <>
                  <span data-lang="es">{stop.addressEs}</span>
                  <span data-lang="en">{stop.address}</span>
                </>
              )
            }
          </dd>
        </div>
        <div>
          <dt>
            <span data-lang="es">Hora</span>
            <span data-lang="en">Time</span>
          </dt>
          <dd>
            <span data-lang="es">{stop.timeEs}</span>
            <span data-lang="en">{stop.time}</span>
          </dd>
        </div>
        {
          stop.rsvpDeadline && (
            <div class="deadline-fact">
              <dt>RSVP</dt>
              <dd>
                <span data-lang="es">{stop.rsvpDeadlineEs}</span>
                <span data-lang="en">{stop.rsvpDeadline}</span>
              </dd>
            </div>
          )
        }
      </dl>
      {
        stop.acceptsRsvp !== false ? (
          <a
            class={`button-primary detail-rsvp ${stop.slug === "monterrey" ? "featured-rsvp" : ""}`}
            href={`/rsvp/${stop.slug}`}
          >
            <span data-lang="es">RSVP para {stop.city}</span>
            <span data-lang="en">RSVP for {stop.city}</span>
          </a>
        ) : (
          stop.addressHref && (
            <a class="button-primary detail-rsvp" href={stop.addressHref}>
              <span data-lang="es">Unirse al servidor</span>
              <span data-lang="en">Join Server</span>
            </a>
          )
        )
      }
    </section>

    <PapelPicado />

    <TourMarquee />

    <section class={`details-copy ${stop.slug === "monterrey" ? "quinta-details" : ""}`} aria-label="Stop details">
      <div class={`details-photo-frame ${stop.slug === "monterrey" ? "quinta-photo-frame" : ""}`}>
        <img
          class="details-photo"
          src={stop.detailPhoto}
          alt={stop.slug === "monterrey" ? "Quinta La Unión" : "Hideki and Jimmi"}
        />
        <div class="details-mascot" aria-hidden="true">
          <img src="/assets/sheepcat.png" alt="" />
        </div>
      </div>
      {
        detailItems.map((item) => (
          <p>
            {"href" in item ? (
              <>
                <span data-lang="es">
                  {item.esText}
                  <a href={item.href}>{item.esLabel}</a>
                </span>
                <span data-lang="en">
                  {item.enText}
                  <a href={item.href}>{item.enLabel}</a>
                </span>
              </>
            ) : (
              <>
                <span data-lang="es">{item.es}</span>
                <span data-lang="en">{item.en}</span>
              </>
            )}
          </p>
        ))
      }
    </section>
  </main>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PapelPicado from "../../components/PapelPicado.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import TourMarquee from "../../components/TourMarquee.astro";
import { getTourStop, tourStops } from "../../data/events";

export function getStaticPaths() {
  return tourStops.map((stop) => ({
    params: { slug: stop.slug }
  }));
}

const stop = getTourStop(Astro.params.slug ?? "");

if (!stop) {
  return Astro.redirect("/");
}
---

<BaseLayout title={`${stop.city} | Hideki & Jimmi Engagement Tour '26`}>
  <SiteHeader />
  <main>
    <section class="detail-hero poster-field" aria-labelledby="stop-title">
      <img class="poster-stamp stamp-detail" src="/assets/lamp.png" alt="" aria-hidden="true" />
      <a class="back-link" href="/#dates">Back to dates</a>
      <p class="kicker">{stop.dateLabel}</p>
      <h1 class="fit-title" id="stop-title">{stop.city}</h1>
      <p class="venue-line">{stop.venue}</p>
      <dl class="stop-facts">
        <div>
          <dt>Date</dt>
          <dd><time datetime={stop.date}>{stop.dateLabel}, 2026</time></dd>
        </div>
        <div>
          <dt>Place</dt>
          <dd>
            {
              stop.addressHref ? (
                <a href={stop.addressHref}>{stop.address}</a>
              ) : (
                stop.address
              )
            }
          </dd>
        </div>
        <div>
          <dt>Time</dt>
          <dd>{stop.time}</dd>
        </div>
        {
          stop.rsvpDeadline && (
            <div class="deadline-fact">
              <dt>RSVP</dt>
              <dd>{stop.rsvpDeadline}</dd>
            </div>
          )
        }
      </dl>
      {
        stop.acceptsRsvp !== false ? (
          <a
            class={`button-primary detail-rsvp ${stop.slug === "monterrey" ? "featured-rsvp" : ""}`}
            href={`/rsvp/${stop.slug}`}
          >
            RSVP for {stop.city}
          </a>
        ) : (
          stop.addressHref && (
            <a class="button-primary detail-rsvp" href={stop.addressHref}>
              Join Server
            </a>
          )
        )
      }
    </section>

    <PapelPicado />

    <TourMarquee />

    <section class="details-copy" aria-label="Stop details">
      <div class="details-photo-frame">
        <img class="details-photo" src={stop.detailPhoto} alt="Hideki and Jimmi" />
        <div class="details-mascot" aria-hidden="true">
          <img src="/assets/sheepcat.png" alt="" />
        </div>
      </div>
      {
        stop.details.map((item) => (
          <p>
            {typeof item === "string" ? (
              item
            ) : (
              <>
                {item.text}
                <a href={item.href}>{item.label}</a>
              </>
            )}
          </p>
        ))
      }
    </section>
  </main>
</BaseLayout>
